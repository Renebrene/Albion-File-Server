# Пример nginx для нативного деплоя АЛЬБИОН (systemd + Waitress на 127.0.0.1:5000).
# Скопируйте в /etc/nginx/sites-available/albion.conf, подставьте домен и пути к сертификатам.
# Лимиты запросов выполняет Flask-Limiter в приложении.
# nginx дополнительно ограничивает параллельные соединения и скорость ответа.
limit_conn_zone $binary_remote_addr zone=conn:10m;

server {
    listen 80;
    server_name files.example.ru;
    # Для Let's Encrypt: вебрут оставляем, остальное редиректим
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name files.example.ru;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Должен быть не меньше max upload в /settings (по умолчанию 50 GiB).
    client_max_body_size 55g;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Публичные скачивания/страницы: ограничить параллельность и скорость.
    # API-загрузка также идёт через этот location; настройте limit_rate под канал.
    location / {
        limit_conn conn 5;
        limit_rate 20m;                      # 20 МБ/с на соединение, настройте под канал
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_body_temp_path /var/cache/nginx/client_temp;
    }

    # Админка (после логина) — без файловых лимитов скорости.
    location /f/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Настройки квот. Доступ проверяет приложение; при желании можно дополнительно
    # ограничить этот location по VPN/IP allowlist.
    location = /settings {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
