[Unit]
Description=Albion File Server
After=network.target

[Service]
Type=simple
User=alexice
Group=alexice
WorkingDirectory=/home/alexice/projects/albion-files
Environment="PATH=/home/alexice/projects/albion-files/venv/bin"
Environment="ALBION_DATA_DIR=/home/alexice/projects/albion-files"
# Метаданные в SQLite (albion.db). Откат: убрать строку и перезапустить службу.
Environment="ALBION_METADATA_BACKEND=sqlite"
# Второй слушатель для локальной сети: офисные пользователи ходят напрямую,
# через тоннель остаётся только внешний доступ. По этому признаку различаются
# «внутренний» и «внешний» клиенты для правила allow_remote.
Environment="ALBION_LAN_HOST=192.168.1.7"
Environment="ALBION_LAN_PORT=5000"
# Тоннель подключается с loopback, поэтому доверяем forwarded-заголовкам только
# от него: так в журнале и лимитах виден настоящий адрес внешнего клиента.
# Заголовкам от локальной сети (и любых других соседей) не верим.
Environment="ALBION_TRUST_PROXY=1"
Environment="ALBION_TRUSTED_PROXY_IPS=127.0.0.1,::1"
Environment="ALBION_BACKUP_DIR=/home/alexice/projects/albion-files/backups"
ExecStart=/home/alexice/projects/albion-files/venv/bin/python /home/alexice/projects/albion-files/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
