# Set to the externally reachable HTTPS origin (no trailing slash)
ALBION_BASE_URL=https://files.example.ru

# Upload/storage quotas (0 disables the corresponding limit)
ALBION_MAX_UPLOAD_GB=50
ALBION_STORAGE_QUOTA_GB=0
ALBION_MIN_FREE_GB=5
ALBION_MAX_ZIP_GB=50
ALBION_MAX_ZIP_FILES=20000
ALBION_EXPORT_ALL_INTERNAL_ONLY=1
ALBION_HOST=127.0.0.1
ALBION_TRUST_PROXY=0
# Set ALBION_TRUST_PROXY=1 only behind a trusted proxy; list proxy peer IPs here.
ALBION_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional shared state for multiple processes/replicas
# ALBION_REDIS_URL=redis://redis:6379/0
# ALBION_RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
